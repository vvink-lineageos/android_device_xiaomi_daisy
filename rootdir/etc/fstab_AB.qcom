# Android fstab file for Xiaomi Mi A2 Lite (daisy) — A/B layout
# <src>                                        <mnt_point>  <type>  <mnt_flags>          <fs_mgr_flags>
/dev/block/platform/soc/7824900.sdhci/by-name/system  /              ext4    ro,barrier=1    wait,slotselect,avb=vbmeta,logical,first_stage_mount
/dev/block/platform/soc/7824900.sdhci/by-name/vendor  /vendor        ext4    ro,barrier=1    wait,slotselect,avb,logical,first_stage_mount
/dev/block/platform/soc/7824900.sdhci/by-name/userdata /data         f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065  wait,check,fileencryption=aes-256-xts:aes-256-cts,keydirectory=/metadata/vold/metadata_encryption
/dev/block/platform/soc/7824900.sdhci/by-name/misc    /misc          emmc    defaults        defaults
/dev/block/platform/soc/7824900.sdhci/by-name/modem   /vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/platform/soc/7824900.sdhci/by-name/persist /mnt/vendor/persist ext4 noatime,nosuid,nodev,barrier=1  wait
